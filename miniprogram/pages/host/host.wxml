<view class="app">
  <view class="header">
    <text class="title">主持中</text>
  </view>

  <step-dots total="{{sectCount}}" current="{{cur}}" />

  <view class="card exec-area">
    <text class="exec-label">{{label}}</text>
    <view class="exec-text">
      <text>{{text}}</text>
    </view>

    <progress-bar percent="{{barPercent}}" />

    <text wx:if="{{audioStatus}}" class="audio-status {{audioWarn ? 'warn' : ''}}">{{audioStatus}}</text>

    <view class="btn-row">
      <button wx:if="{{!finished}}" class="btn btn-secondary" bindtap="onStop">结束</button>
      <button wx:if="{{finished}}" class="btn btn-primary" bindtap="onAgain">重新开始</button>
    </view>
  </view>
</view>
